# iot-pms — environment template. Copy to `.env` (git-ignored) and fill locally.
# Never commit real values. Sources and evidence: docs/architecture/environment-configuration.md
# None of these may use the NEXT_PUBLIC_ prefix: everything here is server-only.

# --- App -------------------------------------------------------------------
LOG_LEVEL=info
# Legacy SQLite file, read only by `bun run db:import-sqlite` (plan F1)
SQLITE_IMPORT_PATH=./var/iot-pms.db
# Run bound to localhost in slice 1: `next dev -H 127.0.0.1` / `next start -H 127.0.0.1`

# --- Dashboard login (Auth.js) ---------------------------------------------
# Random secret for signing session cookies. SECRET. Generate locally, e.g. `openssl rand -base64 32`.
AUTH_SECRET=
# Dashboard base URL. Open the app at http://localhost:3000 (not 127.0.0.1): Next.js/Auth.js redirect to
# "localhost", and a different host would drop the session cookie. The server itself binds to 127.0.0.1.
AUTH_URL=http://localhost:3000

# Google sign-in (optional; enabled only when both are set). From a Google OAuth client. SECRET.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_EMAIL_DOMAIN=bobobox.com
# Optional comma-separated allowlist narrowing the domain; operators get health-check rights.
AUTH_ALLOWED_EMAILS=
AUTH_OPERATOR_EMAILS=

# Fallback login (active until Google is configured). Enabled only when both are set.
AUTH_FALLBACK_USERNAME=
# base64 of a bcrypt hash (base64 avoids `$` expansion in .env). Generate with `scripts/hash-password.ts` (M1).
AUTH_FALLBACK_PASSWORD_HASH_B64=
AUTH_FALLBACK_ROLE=operator

# --- igloohome API (User account, client-credentials flow) -----------------
# Selected contract: docs.igloohome.co snapshot 2026-09-25 (verify with experiment E2).
IGLOOHOME_API_BASE_URL=https://api.igloodeveloper.co/igloohome
IGLOOHOME_AUTH_TOKEN_URL=https://auth.igloohome.co/oauth2/token

# From https://web.igloohome.co/api -> API Access. SECRET.
IGLOOHOME_CLIENT_ID=
IGLOOHOME_CLIENT_SECRET=

# Space-separated. Required: an empty value would grant ALL scopes, so the app refuses to start.
# Plan F3: after People → Sync, the synced list (what igloohome grants our client) is the ceiling and per-user scopes
# are assigned on People. This value then only matters for the shared read token (its read scopes) and until the
# first sync. Tokens never carry scopes iot-pms has no feature for (lock/unlock, master PIN, eKey…).
IGLOOHOME_SCOPES="igloohomeapi/get-devices igloohomeapi/get-properties igloohomeapi/get-device-activity igloohomeapi/get-job-status igloohomeapi/get-battery-level-bridge-proxied-job igloohomeapi/get-device-status-bridge-proxied-job"

IGLOOHOME_HTTP_TIMEOUT_MS=15000

# --- Safety switches -------------------------------------------------------
# Health-check jobs (battery / lock status / Bridge diagnostics) contact devices. Off by default.
IGLOOHOME_ENABLE_BRIDGE_JOBS=false
# M5: allow creating algoPINs (real, working PIN codes on allowlisted locks). Also add the algopin-* scopes to IGLOOHOME_SCOPES.
IGLOOHOME_ENABLE_ALGOPIN=false
# M5: Bridge PIN jobs (4 create custom PIN, 5 delete PIN). Needs scopes igloohomeapi/create-pin-bridge-proxied-job and delete-pin-bridge-proxied-job.
IGLOOHOME_ENABLE_PIN_JOBS=false
# Plan F4b: emergency lock/unlock (Bridge jobs 1/2, PHYSICAL). Super-admin only, reason + own password each time,
# max 3 unlocks per lock per 10 minutes. Off unless "true".
IGLOOHOME_ENABLE_REMOTE_LOCK=false
# Plan G1: lets a SUPER-ADMIN send supported Bridge jobs to devices the docs do not list for them (switch, keypad),
# and use every supported job type in Developer → Try it. Each experiment needs a reason + password and is recorded.
IGLOOHOME_ENABLE_EXPERIMENTS=false
# Deprecated (plan F7): the device registry (Devices → Manage, super-admin) is the allowlist now. If set, this
# comma-separated list of full device IDs is copied into the registry once, on the first start, and ignored afterwards.
# IGLOOHOME_ALLOWED_DEVICE_IDS=

# Devices page (plan F7b): how many cabins/rooms can be watched live at once. Only watched ones call igloohome
# for per-device detail; the rest show the last-known state. 1–10, default 3.
IOT_PMS_MONITOR_MAX=3

# --- Webhooks (receiver at /api/webhooks/igloohome) --------------------------
# igloohome's webhook signature public key (base64, RSA 2048, DER, PKCS1) — from the portal or support.
# Without it, events are still stored but marked "no_key" (untrusted).
IGLOOHOME_WEBHOOK_PUBLIC_KEY=
# Set to true only after a real event has verified as "valid"; then unsigned/invalid events are rejected (401).
IGLOOHOME_WEBHOOK_REQUIRE_VALID_SIGNATURE=false

# Postgres on Colima (docker compose up -d db). Letters and digits only.
POSTGRES_SUPERUSER_PASSWORD=
IOT_PMS_DB_PASSWORD=
DATABASE_URL=postgres://iot_pms:<IOT_PMS_DB_PASSWORD>@127.0.0.1:5432/iot_pms

# --- PIN vault (plan F4) ------------------------------------------------------------------------------------------
# SECRET. 32 random bytes, base64: `openssl rand -base64 32`. Required while algoPIN or PIN-job creation is enabled.
# Losing it makes stored PINs unreadable in iot-pms (the PINs keep working on the locks).
IOT_PMS_PIN_KEY=
